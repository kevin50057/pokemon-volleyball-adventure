{
  "name": "pokemon-volleyball-adventure",
  "private": true,
  "version": "0.1.0",
  "description": "寶可夢排球 Ultimate 遠征版（TypeScript）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages": "node scripts/gen-lang-pages.mjs",
    "build": "npm run pages && npm run strict && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "strict": "node scripts/check-strict.mjs",
    "test": "npm run strict && vitest run",
    "e2e": "npm run build && node e2e/run.mjs",
    "verify": "npm test && npm run e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pixi/canvas-display": "6.4.2",
    "@pixi/canvas-prepare": "6.4.2",
    "@pixi/canvas-renderer": "6.4.2",
    "@pixi/canvas-sprite": "6.4.2",
    "@pixi/constants": "6.4.2",
    "@pixi/core": "6.4.2",
    "@pixi/display": "6.4.2",
    "@pixi/loaders": "6.4.2",
    "@pixi/math": "6.4.2",
    "@pixi/prepare": "6.4.2",
    "@pixi/settings": "6.4.2",
    "@pixi/sound": "4.2.1",
    "@pixi/sprite": "6.4.2",
    "@pixi/sprite-animated": "6.4.2",
    "@pixi/spritesheet": "6.4.2",
    "@pixi/ticker": "6.4.2",
    "@pixi/utils": "6.4.2"
  },
  "devDependencies": {
    "fake-indexeddb": "6.0.0",
    "playwright-core": "^1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
